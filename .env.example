# Копирай на .env локално (за тест) или сложи същите имена като GitHub Actions Secrets.
# НИКОГА не commit-вай истинския .env файл в git.

# --- Anthropic (генериране на текст за постовете) ---
# По избор: ако липсва, пайплайнът пада обратно на локални шаблони (виж src/contentSource/aiCopy.js)
ANTHROPIC_API_KEY=

# --- Meta (Facebook Page + Instagram Business акаунт) ---
# Взима се от Meta for Developers -> твоето App -> Graph API Explorer / System User token
# Трябва да е дълготраен (long-lived) Page Access Token с permissions:
# pages_manage_posts, pages_read_engagement, instagram_content_publish, instagram_basic
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- TikTok (Content Posting API) ---
# https://developers.tiktok.com -> твоето App -> Content Posting API
# Docато app-ът не мине TikTok-ов review, видеата излизат като частен draft, не публичен пост.
TIKTOK_ACCESS_TOKEN=

# --- Rabotim вътрешни данни (по избор, за "реални данни" постовете) ---
# Ендпойнт на твоя сайт/бекенд, който връща JSON с последните завършени услуги/отзиви.
# Виж очаквания формат в src/contentSource/rabotimData.js
RABOTIM_STATS_ENDPOINT=
RABOTIM_STATS_API_KEY=

# --- Публичен хостинг на генерираните снимки/видеа ---
# Meta и TikTok изискват публично достъпен URL (не directly файлов ъплоуд).
# По подразбиране пайплайнът commit-ва assets/ в текущия git repo и ползва
# raw.githubusercontent.com — работи безплатно в GitHub Actions без допълнителна услуга.
PUBLIC_ASSETS_REPO=owner/rabotim-com-git
PUBLIC_ASSETS_BRANCH=social-assets

# --- Известия при грешка (по избор) ---
ALERT_WEBHOOK_URL=
